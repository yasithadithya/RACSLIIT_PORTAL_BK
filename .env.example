# Server
PORT=5000

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/rotaract_sliit

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Allowed frontend origin(s) for CORS, Socket.IO, and email links.
# Comma-separated list allowed; the FIRST url is used in email links.
# Production example: https://racsliit-portal.pages.dev
FRONTEND_URL=http://localhost:5173

# Optional email providers (falls back to console logging if unset)
# RESEND_API_KEY=
# SENDGRID_API_KEY=
